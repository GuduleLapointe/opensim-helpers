#!/usr/bin/env bash
# The version of this build, as VERSION= and DEB_VERSION= lines, what packaging/*.yaml expand: the tag when HEAD is on
# a version tag (v1.1.1 or 1.1.1), else the version being worked on (.version, a pre-release such as 1.1.2-dev) with the
# number of commits and the hash of HEAD, 1.1.2-dev.14+g1a2b3c4 (g is for git, as git describe writes it: the hash is
# what follows), and .dirty when files are changed (commit before a build you keep: the hash must exist).

set -e
cd "$(dirname "$0")/.."

if tag=$(git describe --tags --exact-match --match 'v[0-9]*' --match '[0-9]*' 2>/dev/null); then
    version=${tag#v}
else
    base=$(tr -d '[:space:]' <.version)
    [[ "$base" == *-* ]] || base=$base-dev
    dirty=
    git diff --quiet HEAD || dirty=.dirty
    version=$base.$(git rev-list --count HEAD)+g$(git rev-parse --short HEAD)$dirty
fi

echo "VERSION=$version"
echo "DEB_VERSION=${version/-/\~}"
