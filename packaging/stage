#!/usr/bin/env bash
# Prepares in DIR (made new) what the project distributes, as committed (HEAD) without what .distignore leaves out,
# and the vendor folder composer makes without the development tools. Composer follows the repositories of composer.json and
# composer.lock, a path repository in development, else Packagist, and works on the copy: the project is not touched.
# What comes from a path is copied (what git archive gives of it), not linked.
#
#   packaging/stage DIR zip    every dependency in the vendor folder
#   packaging/stage DIR deb    the same, but the projects of packaging/siblings are left out: their own packages bring them

set -e
cd "$(dirname "$0")/.."
root=$PWD
mode=${2:-zip}
rm -rf "$1"
mkdir -p "$1"
dir=$(cd "$1" && pwd)

# Leaves out of a folder what a .distignore file says, one pattern per line (as rsync reads them): /name at the root of
# the folder, name anywhere in it, a trailing / for a folder, a glob is fine
left_out() {
    local folder=$1 entries entry
    entries=$(awk '!/^#/ && NF' "$2")
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        entry=${entry%/}
        if [[ "$entry" == */* ]]; then
            # shellcheck disable=SC2086
            rm -rf "${folder:?}"/${entry#/}
        else
            find "$folder" -name "$entry" -prune -exec rm -rf {} +
        fi
    done <<<"$entries"
}

git archive HEAD | tar -x -C "$dir"
left_out "$dir" .distignore

# A relative path repository (../opensim-rest-php) is searched from the copy: the sibling is found next to it
parent=$(dirname "$dir")
links=()
while IFS= read -r url; do
    [[ "$url" == ../* ]] || continue
    name=$(basename "${url%/}")
    if [[ ! -e "$parent/$name" ]]; then
        ln -s "$(cd "$root/$url" && pwd -P)" "$parent/$name"
        links+=("$parent/$name")
    fi
done < <(php -r '$json = json_decode(file_get_contents("composer.json"), true); foreach ($json["repositories"] ?? [] as $repository) { if (($repository["type"] ?? "") === "path") { echo $repository["url"], "\n"; } }')

composer install --no-dev --no-interaction --quiet --optimize-autoloader --working-dir="$dir"

# What composer took from a path (linked or copied, as it can) is replaced by what git archive gives of that project,
# without what its own .distignore leaves out: the dependency is as it would be from its repository
siblings=$(awk '!/^#/ && NF {print $1}' packaging/siblings 2>/dev/null || true)
while read -r name url; do
    [[ -n "$name" ]] || continue
    rm -rf "${dir:?}/vendor/$name"
    if [[ $mode == deb ]] && grep -qx "$name" <<<"$siblings"; then
        continue
    fi
    target=$(cd "$dir" && cd "$url" && pwd -P)
    mkdir -p "$dir/vendor/$name"
    if git -C "$target" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$target" archive HEAD | tar -x -C "$dir/vendor/$name"
    else
        cp -R "$target/." "$dir/vendor/$name/"
    fi
    # That project says itself what it leaves out of what it distributes
    [[ ! -f "$dir/vendor/$name/.distignore" ]] || left_out "$dir/vendor/$name" "$dir/vendor/$name/.distignore"
done < <(php -r '$lock = json_decode(file_get_contents($argv[1]), true); foreach ($lock["packages"] ?? [] as $package) { if (($package["dist"]["type"] ?? "") === "path") { echo $package["name"], " ", $package["dist"]["url"], "\n"; } }' "$dir/composer.lock")
# Left out of the package even when composer got them from Packagist
if [[ $mode == deb ]]; then
    for name in $siblings; do
        rm -rf "${dir:?}/vendor/$name"
    done
fi
rm -f "${links[@]}"
rm -f "$dir/composer.lock"
chmod -R u+rwX,go+rX,go-w "$dir"
