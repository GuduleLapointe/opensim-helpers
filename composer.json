{
  "name": "magicoli/opensim-helpers",
  "description": "Helpers needed to enable common functionalties like search, currency, events in OpenSimulator grids.",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Gudule Lapointe",
      "email": "gudule@speculoos.world"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-filter": "*",
    "ext-gettext": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "magicoli/opensim-engine": "dev-dev",
    "magicoli/opensim-rest-php": "dev-dev",
    "phpxmlrpc/phpxmlrpc": "^4.11"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "magicoli/pest-failure-summary": "^1.0",
    "pestphp/pest": "^3.0",
    "phpcompatibility/php-compatibility": "dev-develop",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../opensim-engine",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-engine": "dev-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../opensim-rest-php",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-rest-php": "dev-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "scripts": {
    "test": "pest"
  },
  "suggest": {
    "ext-imagick": "textgen.php, the text images"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true
}
