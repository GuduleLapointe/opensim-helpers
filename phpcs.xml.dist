<?xml version="1.0"?>
<ruleset name="opensim-helpers PHP compatibility">
    <description>The PHP versions the code supports. The range comes from composer.json, given by tests/Environment/PhpCompatibilityTest.php.</description>

    <rule ref="PHPCompatibility">
        <!-- xmlrpc_*() were removed from PHP 8.0, the web helpers need them: opensim-helpers loads includes/xmlrpc-polyfill.php, built on phpxmlrpc/phpxmlrpc -->
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_encodeRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_decodeRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_encode_requestRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_is_faultRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_server_createRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_server_register_methodRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_server_call_methodRemoved"/>
        <exclude name="PHPCompatibility.FunctionUse.RemovedFunctions.xmlrpc_server_destroyRemoved"/>
    </rule>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/contrib/*</exclude-pattern>
    <exclude-pattern>*/upstream/*</exclude-pattern>
    <exclude-pattern>*/core/*</exclude-pattern>
    <exclude-pattern>*/dev/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <arg name="extensions" value="php"/>
</ruleset>
